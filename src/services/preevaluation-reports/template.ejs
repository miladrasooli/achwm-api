<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="title" content="Pre-Evaluation Report" />
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,500,600,700,900" rel="stylesheet" />
    <style>
      /* ensure no margins on pdf */
      @page :first {
        size: A4;
        margin: 0;
      }

      :root {
        --background-paper: #FFFFFF;
      }

      h1 {
        font-size: 40px;
        line-height: 60px;
        text-align: center;
        font-weight: 400;
      }

      h2 {
        font-size: 32px;
        line-height: 48px;
        text-align: center;
        font-weight: 400;
      }

      p {
        font-size: 16px;
        line-height: 24px;
        font-weight: 400
      }

      table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid black;
        font-size: 16px;
        font-weight: 400;
      }

      th {
        border: 1px solid black;
        padding: 6px 12px;
        text-align: left;
      }

      td {
        border: 1px solid black;
        padding: 6px 12px;
      }

      td:first-child {
        width: 100%;
      }

      .questionTable td:first-child {
        width: auto;
      }

      .questionTable td:nth-child(2) {
        width: 100%;
      }

      .page {
        height: 1123px;
        width: 794px;
        box-sizing: border-box;
        page-break-after: always;
        page-break-inside: avoid;
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 1in 0.5in;
        background-color: var(--background-paper);
        margin-bottom: 16px;
        font-family: 'Montserrat', serif;
        gap: 2rem;
      }

      .logo {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
      }

      .caption {
        font-size: 12px;
        line-height: 18px;
      }

      .legend {
        display: flex;
        width: 100%;
        justify-content: space-evenly;
        gap: 16px;
        margin-bottom: 12px;
      }

      .legendItem {
        display: flex;
        align-items: center;
        gap: 8px;
      }
    </style>
    <title>ACHWM Pre-Evaluation Report</title>
  </head>

  <body>
    <div class="page">
      <div class="logo">
        <%- include ('./logo.svg') %>
      </div>
      <h1><%= projectName %></h1>
      <h2>Follow-Up Assessment</h2>
      <p>
        This report was generated by the ACHWM.ca website based on the data you have uploaded to the server. All of the
        raw data that contributed to this report is available to you upon request. The raw data may be helpful to you in
        gaining a better understanding of the results in this report. Please contact a member of the ACHWM when you are
        ready to arrange for a copy of the data to be transferred.
      </p>
      <p class="caption">
        Important: The community acknowledges that this report is confidential. The community agrees that they will be
        responsible for removing any information based on fewer than 5 participants before reporting publicly. This is
        important to protect the confidentiality of the children. By using this report you accept these responsibilities
        on behalf of your community.
      </p>
    </div>
    <div class="page">
      <h2>Participant Characteristics</h2>
      <div><%- participantCharacteristicsTable %></div>
      <div><%- participantCharacteristicsHistogram %></div>
    </div>
    <div class="page">
      <h2>Locations</h2>
      <div><%- locationsTable %></div>
      <div><%- locationsPieChart %></div>
    </div>
    <div class="page">
      <h2>Global Health Ratings</h2>
      <div><%- globalHealthRatingsTable %></div>
      <div><%- globalHealthRatingsPieChart %></div>
    </div>
    <div class="page">
      <h2>Distribution of Scores by Quadrant</h2>
      <div><%- scoresByQuadrantTable %></div>
      <div><%- scoresByQuadrantBoxPlot %></div>
    </div>
    <div class="page">
      <div><%- spiritualHistogram %></div>
      <div><%- emotionalHistogram %></div>
    </div>
    <div class="page">
      <div><%- physicalHistogram %></div>
      <div><%- mentalHistogram %></div>
    </div>
    <div class="page">
      <div><%- summaryHistogram %></div>
    </div>
    <div class="page">
      <h2>Clinician Assessments</h2>
      <div><%- clinicianAssessmentsPieChart %></div>
    </div>
    <div class="page">
      <h2>ACHWM Balance Diagram</h2>
      <div><%- balanceChart %></div>
    </div>
    <% for (const table of positiveQuestionsTables) { %>
      <div class="page">
        <h2>Positive Questions</h2>
        <p>Percentage of respondents that answered 'often' or 'always'</p>
        <div class="questionTable"><%- table %></div>
      </div>
    <% } %>
    <% for (const table of negativeQuestionsTables) { %>
      <div class="page">
        <h2>Negative Questions</h2>
        <p>Percentage of respondents that answered 'sometimes', 'often' or 'always'</p>
        <div class="questionTable"><%- table %></div>
      </div>
    <% } %>
    <% for (const {table, title} of shortAnswerQuestionsTables) { %>
      <div class="page">
        <h2><%- title %></h2>
        <div><%- table %></div>
      </div>
    <% } %>
  </body>
</html>
